# ---------- Meta Model API (server-only) ----------
# Bearer key for https://api.meta.ai/v1 (muse-spark-1.3, muse-image-1.0, sam-3.1).
# Never prefix with NEXT_PUBLIC_.
MODEL_API_KEY=

# Set to "true" to call muse-image-1.0 and store results in Supabase Storage.
# Anything else returns a placeholder image URL (saves credits while developing).
MUSE_IMAGE_ENABLED=false

# ---------- Supabase ----------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for Storage uploads in /api/image. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- LiveKit (optional) ----------
# Leave empty to show the "Live Feed unavailable" placeholder instead of crashing.
# Example: wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=
# Endpoint that returns a LiveKit viewer token as JSON: { "token": "..." }
NEXT_PUBLIC_LIVEKIT_TOKEN_ENDPOINT=

# Optional: public origin of your deployment (used by sitemap.xml and robots.txt).
NEXT_PUBLIC_SITE_URL=

# Optional: set to "true" to test without a Meta key. The guide then streams canned demo replies.
# Ignored whenever MODEL_API_KEY is set.
DEMO_MODE=
